{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "neocore codex-prompt-hook --plugin",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "neocore codex-stop-hook --plugin",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
